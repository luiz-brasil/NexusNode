---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a href={post.data.linkUrl} target="_blank" rel="noopener noreferrer" class="group relative block aspect-square w-full overflow-hidden rounded-xl bg-gray-100 transition-transform hover:scale-[1.02]">
  <img 
    src={post.data.imageUrl} 
    alt={post.data.caption} 
    class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-80"
    loading="lazy"
  />
  <div class="absolute inset-0 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100 bg-black/50">
    <p class="text-center text-sm font-medium text-white sm:text-base">
      {post.data.caption}
    </p>
  </div>
</a>
